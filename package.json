{
  "name": "stuck-in-line",
  "version": "0.1.0",
  "description": "A browser game about waiting in a line. MVP: shared queue, NPCs, Three.js portrait client.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "brand:build": "python3 scripts/build-brand-assets.py",
    "brand:check": "node scripts/brand-check.js",
    "pretest": "node scripts/brand-check.js",
    "test": "node test/sim.js",
    "build:worker": "node scripts/build-worker-assets.js",
    "deploy": "npm run build:worker && wrangler deploy",
    "dev:worker": "npm run build:worker && wrangler dev"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "private": true,
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}
